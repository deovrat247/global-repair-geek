RewriteEngine On

# Redirect HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Ensure www.globalrepairgeek.com redirects to globalrepairgeek.com
RewriteCond %{HTTP_HOST} ^www\.globalrepairgeek\.com$ [NC]
RewriteRule ^(.*)$ https://globalrepairgeek.com/$1 [R=301,L] 

# Block web access to .env files (credentials) and other dotfiles such as .gitignore
<FilesMatch "^\.(env|git)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
