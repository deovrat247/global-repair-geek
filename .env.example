# Copy this file to ".env" (same folder) and fill in the real values.
# The real .env is never committed to git and is blocked from the web by .htaccess.

# SMTP server used to send order emails (leave SMTP_HOST empty to use PHP mail() instead)
SMTP_HOST=
# 587 with tls, or 465 with ssl
SMTP_PORT=587
# tls, ssl or none
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# Address the email is sent from (should be a mailbox on your own domain)
MAIL_FROM=info@globalrepairgeek.com
MAIL_FROM_NAME="L&A LLC Website"

# Inbox that receives the order details
MAIL_TO=info@globalrepairgeek.com
